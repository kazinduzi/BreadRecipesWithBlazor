@page "/edit-recipe/{Id:int}"
@inject IRecipeService RecipeService
@inject NavigationManager NavigationManager

<h3>Edit Recipe</h3>

@if (model == null)
{
 <p>Loading...</p>
}
else
{
 <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
 <DataAnnotationsValidator />
 <ValidationSummary />

 <div class="mb-3">
 <label class="form-label">Name</label>
 <InputText class="form-control" @bind-Value="model.Name" />
 </div>

 <div class="mb-3">
 <label class="form-label">Duration (minutes)</label>
 <InputNumber class="form-control" @bind-Value="model.DurationInMinutes" />
 </div>

 <div class="mb-3">
 <label class="form-label">Healthy Status</label>
 <InputSelect class="form-select" @bind-Value="model.HealthyStatus">
 <option value="0">Healthy</option>
 <option value="1">NotHealthy</option>
 </InputSelect>
 </div>

 <h4>Ingredients</h4>

 @{
 var ingredientsSnapshot = model.Ingredients?.ToList() ?? new List<IngredientInputModel>();
 }

 @for (int i =0; i < ingredientsSnapshot.Count; i++)
 {
 var ing = ingredientsSnapshot[i];
 <div class="ingredient-row mb-2 d-flex gap-2">
 <input
 class="form-control"
 placeholder="Name"
 value="@ing.Name"
 @oninput="(ChangeEventArgs e) => SetIngredientName(i, e.Value?.ToString())" />

 <input
 type="number"
 class="form-control"
 placeholder="Qty"
 value="@ing.Quantity"
 @oninput="(ChangeEventArgs e) => SetIngredientQuantityFromString(i, e.Value?.ToString())" />

 <input
 class="form-control"
 placeholder="Unit"
 value="@ing.UnityOfMeasure"
 @oninput="(ChangeEventArgs e) => SetIngredientUnit(i, e.Value?.ToString())" />

 <button type="button" class="btn btn-outline-danger" @onclick="(() => RemoveIngredient(i))">Remove</button>
 </div>
 }

 <button type="button" class="btn btn-outline-primary mb-3" @onclick="AddIngredient">Add Ingredient</button>

 <div>
 <button type="submit" class="btn btn-primary">Save Recipe</button>
 <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
 </div>
 </EditForm>
}

@code {
 [Parameter]
 public int Id { get; set; }

 private RecipeInputModel model;

 protected override async Task OnInitializedAsync()
 {
 var recipe = await RecipeService.GetRecipeByIdAsync(Id);
 model = new RecipeInputModel
 {
 Name = recipe.Name,
 DurationInMinutes = recipe.DurationInMinutes,
 HealthyStatus = recipe.HealthyStatus,
 Ingredients = recipe.Ingredients?.Select(i => new IngredientInputModel
 {
 Name = i.Name,
 Quantity = i.Quantity,
 UnityOfMeasure = i.UnityOfMeasure
 }).ToList() ?? new List<IngredientInputModel>()
 };
 }

 private async Task HandleValidSubmit()
 {
 var success = await RecipeService.UpdateRecipeAsync(Id, model);
 if (success)
 {
 NavigationManager.NavigateTo("/");
 }
 }

 private void AddIngredient()
 {
 model.Ingredients ??= new List<IngredientInputModel>();
 model.Ingredients.Add(new IngredientInputModel());
 }

 private void RemoveIngredient(int idx)
 {
 if (model?.Ingredients == null)
 {
 return;
 }

 if (idx >=0 && idx < model.Ingredients.Count)
 {
 model.Ingredients.RemoveAt(idx);
 }
 }

 private void Cancel() => NavigationManager.NavigateTo("/");

 private void SetIngredientName(int idx, string value)
 {
 if (model?.Ingredients == null)
 {
 return;
 }

 if (idx <0 || idx >= model.Ingredients.Count)
 {
 return;
 }

 model.Ingredients[idx].Name = value;
 }

 private void SetIngredientQuantityFromString(int idx, string value)
 {
 if (model?.Ingredients == null)
 {
 return;
 }

 if (idx <0 || idx >= model.Ingredients.Count)
 {
 return;
 }

 if (int.TryParse(value, out var parsed))
 {
 model.Ingredients[idx].Quantity = parsed;
 }
 else
 {
 model.Ingredients[idx].Quantity =0;
 }
 }

 private void SetIngredientUnit(int idx, string value)
 {
 if (model?.Ingredients == null)
 {
 return;
 }

 if (idx <0 || idx >= model.Ingredients.Count)
 {
 return;
 }

 model.Ingredients[idx].UnityOfMeasure = value;
 }
}
