@page "/recipe/{Id:int}/edit"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using SharedLibrary.Constants
@using ViewModels
@using System
@using System.Linq
@using System.Net.Http
@using System.Net.Http.Json

<h3 class="mb-4">
	<i class="oi oi-pencil"></i> Edit Recipe
</h3>

@if (isLoading)
{
	<div class="text-center py-5">
		<div class="spinner-border text-primary" role="status">
			<span class="sr-only">Loading...</span>
		</div>
		<p class="mt-2 text-muted">Loading recipe...</p>
	</div>
}
else if (errorMessage != null)
{
	<div class="alert alert-danger" role="alert">
		<strong>Error:</strong> @errorMessage
		<div class="mt-2">
			<button class="btn btn-sm btn-outline-danger" @onclick="LoadRecipe">Retry</button>
			<button class="btn btn-sm btn-secondary ml-2" @onclick="Cancel">Cancel</button>
		</div>
	</div>
}
else if (recipe == null)
{
	<div class="alert alert-warning" role="alert">
		Recipe not found.
		<button class="btn btn-sm btn-secondary ml-2" @onclick="Cancel">Go Back</button>
	</div>
}
else
{
    <EditForm Model="editModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-row">
            <div class="form-group col-md-6">
                <label><strong>Recipe Name</strong></label>
                <InputText class="form-control" @bind-Value="editModel.Name" placeholder="Enter recipe name" />
            </div>
            <div class="form-group col-md-3">
                <label><strong>Duration (minutes)</strong></label>
                <InputNumber class="form-control" @bind-Value="editModel.DurationInMinutes" />
            </div>
            <div class="form-group col-md-3">
                <label><strong>Health Status</strong></label>
                <InputSelect class="form-control" @bind-Value="editModel.HealthyStatus">
                    <option value="@HealthyStatus.Healthy">Healthy</option>
                    <option value="@HealthyStatus.NotHealthy">Not Healthy</option>
                </InputSelect>
            </div>
        </div>

        <div class="ingredients-section mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="oi oi-list"></i> Ingredients</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddIngredient">
                    <i class="oi oi-plus"></i> Add Ingredient
                </button>
            </div>
            @if (ingredients.Count == 0)
            {
                <div class="alert alert-info">No ingredients added. Click "Add Ingredient" to get started.</div>
            }
            else
            {
                @for (var i = 0; i < ingredients.Count; i++)
                {
                    <div class="ingredient-form-row mb-3">
                        <div class="form-row align-items-end">
                            <div class="form-group col-md-5">
                                <label>Ingredient Name</label>
                                <InputText class="form-control" @bind-Value="ingredients[i].Name" placeholder="e.g., Flour" />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Quantity</label>
                                <InputNumber class="form-control" @bind-Value="ingredients[i].Quantity" />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Unit</label>
                                <InputText class="form-control" @bind-Value="ingredients[i].UnityOfMeasure" placeholder="e.g., cups" />
                            </div>
                            <div class="form-group col-md-1">
                                <button type="button" class="btn btn-outline-danger btn-sm w-100" @onclick="(()=>RemoveIngredient(i))" title="Remove ingredient">
                                    <i class="oi oi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="form-actions mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary btn-lg" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm mr-2" role="status"></span>
                }
                <i class="oi oi-check"></i> Save Changes
            </button>
            <button type="button" class="btn btn-secondary btn-lg ml-2" @onclick="Cancel" disabled="@isSaving">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RecipeModel recipe;
    private RecipeInputModel editModel = new RecipeInputModel();
    private List<IngredientInputModel> ingredients = new List<IngredientInputModel>();
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecipe();
    }

    private async Task LoadRecipe()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await Http.GetAsync($"api/recipe/{Id}");
            if (response.IsSuccessStatusCode)
            {
                recipe = await response.Content.ReadFromJsonAsync<RecipeModel>();
                if (recipe != null)
                {
                    editModel.Name = recipe.Name;
                    editModel.DurationInMinutes = recipe.DurationInMinutes;
                    editModel.HealthyStatus = recipe.HealthyStatus;
                    ingredients = recipe.Ingredients?.Select(i => new IngredientInputModel
                    {
                        Name = i.Name,
                        Quantity = i.Quantity,
                        UnityOfMeasure = i.UnityOfMeasure
                    }).ToList() ?? new List<IngredientInputModel>();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Recipe not found.";
                recipe = null;
            }
            else
            {
                errorMessage = $"Failed to load recipe. Status: {response.StatusCode}";
                recipe = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            recipe = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddIngredient() => ingredients.Add(new IngredientInputModel());
    private void RemoveIngredient(int index)
    {
        if (index >= 0 && index < ingredients.Count) ingredients.RemoveAt(index);
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            editModel.Ingredients = ingredients.ToArray();
            var resp = await Http.PutAsJsonAsync($"api/recipe/{Id}", editModel);
            if (resp.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo($"/recipe/{Id}");
            }
            else
            {
                var errorContent = await resp.Content.ReadAsStringAsync();
                errorMessage = $"Failed to save recipe: {resp.StatusCode}. {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo($"/recipe/{Id}");
    }

    public class RecipeInputModel
    {
        public string Name { get; set; }
        public int DurationInMinutes { get; set; }
        public HealthyStatus HealthyStatus { get; set; }
        public IngredientInputModel[] Ingredients { get; set; }
    }
    public class IngredientInputModel
    {
        public string Name { get; set; }
        public int Quantity { get; set; }
        public string UnityOfMeasure { get; set; }
    }
}
