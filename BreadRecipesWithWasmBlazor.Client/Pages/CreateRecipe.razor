@page "/recipe/new"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using SharedLibrary.Constants

<h3>Create Recipe</h3>

<EditForm Model="recipe" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-row">
        <div class="form-group col-md-6">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="recipe.Name" />
        </div>
        <div class="form-group col-md-3">
            <label>Duration (min)</label>
            <InputNumber class="form-control" @bind-Value="recipe.DurationInMinutes" />
        </div>
        <div class="form-group col-md-3">
            <label>Health</label>
            <InputSelect class="form-control" @bind-Value="recipe.HealthyStatus">
                <option value="@HealthyStatus.Healthy">Healthy</option>
                <option value="@HealthyStatus.NotHealthy">NotHealthy</option>
            </InputSelect>
        </div>
    </div>

    <h5 class="mt-3">Ingredients</h5>
    @for (var i = 0; i < ingredients.Count; i++)
    {
        <div class="form-row align-items-end">
            <div class="form-group col-md-5">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="ingredients[i].Name" />
            </div>
            <div class="form-group col-md-3">
                <label>Quantity</label>
                <InputNumber class="form-control" @bind-Value="ingredients[i].Quantity" />
            </div>
            <div class="form-group col-md-3">
                <label>Unit</label>
                <InputText class="form-control" @bind-Value="ingredients[i].UnityOfMeasure" />
            </div>
            <div class="form-group col-md-1">
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="(()=>RemoveIngredient(i))">X</button>
            </div>
        </div>
    }
    <button type="button" class="btn btn-sm btn-secondary" @onclick="AddIngredient">Add Ingredient</button>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
        <button type="button" class="btn btn-link text-light" @onclick="Cancel">Cancel</button>
    </div>
</EditForm>

@code {
    private RecipeInputModel recipe = new RecipeInputModel();
    private List<IngredientInputModel> ingredients = new List<IngredientInputModel>();

    protected override void OnInitialized()
    {
        ingredients.Add(new IngredientInputModel());
    }

    private void AddIngredient()
    {
        ingredients.Add(new IngredientInputModel());
    }

    private void RemoveIngredient(int index)
    {
        if (index >= 0 && index < ingredients.Count)
            ingredients.RemoveAt(index);
    }

    private async Task HandleValidSubmit()
    {
        recipe.Ingredients = ingredients.ToArray();
        var resp = await Http.PostAsJsonAsync("api/recipe/create", recipe);
        if (resp.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/");
    }

    public class RecipeInputModel
    {
        public string Name { get; set; }
        public int DurationInMinutes { get; set; }
        public HealthyStatus HealthyStatus { get; set; }
        public IngredientInputModel[] Ingredients { get; set; }
    }

    public class IngredientInputModel
    {
        public string Name { get; set; }
        public int Quantity { get; set; }
        public string UnityOfMeasure { get; set; }
    }
}
