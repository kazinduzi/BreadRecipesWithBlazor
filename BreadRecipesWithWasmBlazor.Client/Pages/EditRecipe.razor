@page "/recipe/{Id:int}/edit"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using SharedLibrary.Constants
@using ViewModels

<h3>Edit Recipe</h3>

@if (recipe == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="editModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="editModel.Name" />
            </div>
            <div class="form-group col-md-3">
                <label>Duration (min)</label>
                <InputNumber class="form-control" @bind-Value="editModel.DurationInMinutes" />
            </div>
            <div class="form-group col-md-3">
                <label>Health</label>
                <InputSelect class="form-control" @bind-Value="editModel.HealthyStatus">
                    <option value="@HealthyStatus.Healthy">Healthy</option>
                    <option value="@HealthyStatus.NotHealthy">NotHealthy</option>
                </InputSelect>
            </div>
        </div>

        <h5 class="mt-3">Ingredients</h5>
        @for (var i = 0; i < ingredients.Count; i++)
        {
            <div class="form-row align-items-end">
                <div class="form-group col-md-5">
                    <label>Name</label>
                    <InputText class="form-control" @bind-Value="ingredients[i].Name" />
                </div>
                <div class="form-group col-md-3">
                    <label>Quantity</label>
                    <InputNumber class="form-control" @bind-Value="ingredients[i].Quantity" />
                </div>
                <div class="form-group col-md-3">
                    <label>Unit</label>
                    <InputText class="form-control" @bind-Value="ingredients[i].UnityOfMeasure" />
                </div>
                <div class="form-group col-md-1">
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="(()=>RemoveIngredient(i))">X</button>
                </div>
            </div>
        }
        <button type="button" class="btn btn-sm btn-secondary" @onclick="AddIngredient">Add Ingredient</button>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-link text-light" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RecipeModel recipe;
    private RecipeInputModel editModel = new RecipeInputModel();
    private List<IngredientInputModel> ingredients = new List<IngredientInputModel>();

    protected override async Task OnInitializedAsync()
    {
        recipe = await Http.GetFromJsonAsync<RecipeModel>($"api/recipe/{Id}");
        if (recipe != null)
        {
            editModel.Name = recipe.Name;
            editModel.DurationInMinutes = recipe.DurationInMinutes;
            editModel.HealthyStatus = recipe.HealthyStatus;
            ingredients = recipe.Ingredients.Select(i => new IngredientInputModel
                {
                    Name = i.Name,
                    Quantity = i.Quantity,
                    UnityOfMeasure = i.UnityOfMeasure
                }).ToList();
        }
    }

    private void AddIngredient() => ingredients.Add(new IngredientInputModel());
    private void RemoveIngredient(int index)
    {
        if (index >= 0 && index < ingredients.Count) ingredients.RemoveAt(index);
    }

    private async Task HandleValidSubmit()
    {
        editModel.Ingredients = ingredients.ToArray();
        var resp = await Http.PutAsJsonAsync($"api/recipe/{Id}", editModel);
        if (resp.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo($"/recipe/{Id}");
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo($"/recipe/{Id}");
    }

    public class RecipeInputModel
    {
        public string Name { get; set; }
        public int DurationInMinutes { get; set; }
        public HealthyStatus HealthyStatus { get; set; }
        public IngredientInputModel[] Ingredients { get; set; }
    }
    public class IngredientInputModel
    {
        public string Name { get; set; }
        public int Quantity { get; set; }
        public string UnityOfMeasure { get; set; }
    }
}
