<nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary shadow-sm">
    <a class="navbar-brand font-weight-bold" href="">Bread Recipes</a>
    <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse @(collapseNavMenu ? string.Empty : "show")">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="counter">Counter</NavLink>
            </li>
        </ul>
        <span class="navbar-text text-light small">Made with Blazor WebAssembly</span>
